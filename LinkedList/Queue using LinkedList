#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node *next;
};

struct Head
{
    int count;
    Node *front;
    Node *rear;
};

class Myqueue
{
public:
    Head *h;

    void createqueue()
    {
        h = new Head;
        h->count = 0;
        h->front = NULL;
        h->rear = NULL;
    }

    void enqueue(int x)
    {
        Node *nn = new Node;

        nn->data = x;
        nn->next = NULL;

        if (h->rear == NULL)
        {
            // Queue is empty
            h->front = nn;
            h->rear = nn;
        }
        else
        {
            h->rear->next = nn;
            h->rear = nn;
        }

        h->count++;
    }

    void dequeue()
    {
        if (h->front == NULL)
        {
            cout << "empty" << endl;
            return;
        }

        Node *temp = h->front;

        cout << "Deleted: " << temp->data << endl;

        h->front = temp->next;

        if (h->front == NULL)
        {
            // Queue became empty
            h->rear = NULL;
        }

        delete temp;
        h->count--;
    }

    void peek()
    {
        if (h->front == NULL)
        {
            cout << "empty" << endl;
            return;
        }

        cout << "peek: " << h->front->data << endl;
    }

    void display()
    {
        if (h->front == NULL)
        {
            cout << "empty" << endl;
            return;
        }

        Node *temp = h->front;

        while (temp != NULL)
        {
            cout << temp->data << " ";
            temp = temp->next;
        }

        cout << endl;
    }
};
int main()
{
    Myqueue q;
    q.createqueue();

    int choice, x;

    do
    {
        cout << "\n----- QUEUE MENU -----" << endl;
        cout << "1. Enqueue" << endl;
        cout << "2. Dequeue" << endl;
        cout << "3. Peek" << endl;
        cout << "4. Display" << endl;
        cout << "5. Exit" << endl;
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            cout << "Enter value: ";
            cin >> x;
            q.enqueue(x);
            break;

        case 2:
            q.dequeue();
            break;

        case 3:
            q.peek();
            break;

        case 4:
            q.display();
            break;

        case 5:
            cout << "Exiting..." << endl;
            break;

        default:
            cout << "Invalid choice" << endl;
        }

    } while (choice != 5);

    return 0;
}
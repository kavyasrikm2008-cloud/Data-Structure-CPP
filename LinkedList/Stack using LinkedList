#include<iostream>
using namespace std;
struct Node
{
    int data;
    struct Node *next;
};
struct Head 
{
    int count = 0;
    Node *top;
};
Head *createHead()
{
    Head *h = new Head();
    h->count = 0;
    h->top = NULL;
    return h;
}
void push(Head *h,int x)
{
    Node *nn = new Node();
    nn->data = x;
    nn->next = h->top;
    h->top = nn;
    h->count++;
}
void pop(Head *h)
{
    if(h->top == NULL)
    {
        cout<<"list empty"<<endl;
        return;
    }
   Node* temp = h->top;
    cout<<temp->data;
    h->top = temp->next;
    delete temp;
    h->count--;
}
void peek(Head *h)
{
    if(h->top == NULL)
    {
        cout<<"list empty"<<endl;
        return;
    }
    cout<<h->top->data;
}
void isEmpty(Head *h)
{
    if(h->top == NULL)
    {
        cout<<"list Empty"<<endl;
        return;
    }
    else
    {
        cout<<"list is not empty"<<endl;
    }
}
void count(Head *h)
{
    cout<<h->count;
}
void display(Head *h)
{
    if(h->top == NULL)
    {
        cout<<"list empty"<<endl;
        return;
    }
    
    Node *temp = h->top;
    while(temp!=NULL)
    {
        cout<<temp->data<<" ";
        temp = temp->next;
    }
}
int main()
{
    Head *h = createHead();
    int ch,num;
    do{
        cout<<"\n 1. PUSH "<<endl;
        cout<<"2. POP "<<endl;
        cout<<"3. PEEK "<<endl;
        cout<<"4. ISEMPTY "<<endl;
        cout<<"5. COUNT "<<endl;
        cout<<"6. DISPLAY "<<endl;
        cout<<"7. EXIT "<<endl;
        cout<<endl;
        cout<<"Enter your choice: ";
        cin>>ch;
        
        switch(ch)
        {
            case 1:
            cout<<"Enter element: ";
            cin>>num;
            push(h,num);
            break;
            
            case 2:
            pop(h);
            break;
            
            case 3:
            peek(h);
            break;
            
            case 4:
            isEmpty(h);
            break;
            
            case 5:
            count(h);
            break;
            
            case 6:
            display(h);
            break;
            
            case 7:
            cout<<"Exit"<<endl;
            break;
            
            default:
            cout<<"Invalid choice"<<endl;
            
            
        }
    }while(ch!=7);
    
}

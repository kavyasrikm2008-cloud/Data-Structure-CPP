

#include<iostream>
using namespace std;
struct Node
{
    int data;
    Node *next;
};
struct Head 
{
    int count;
    Node *top;
};
class Mystack
{
    public:
    Head *h;
    void createstack()
    {
        h = new Head;
        h->count = 0;
        h->top = NULL;
    }
    void push(int x)
    {
        Node *nn = new Node;
        nn->data = x;
        nn->next = h->top;
        h->top = nn;
        h->count++;
    }
    void pop()
    {
        if(h->top==NULL)
        {
            cout<<"empty"<<endl;
            return;
        }
        Node *temp = h->top;
        cout<<temp->data;
        h->top = temp->next;
        delete temp;
        h->count--;
    }
    void peek()
    {
       if(h->top==NULL)
        {
            cout<<"empty"<<endl;
            return;
        }
        cout<<"peek: "<<h->top->data;
    }
    void display()
    {
        if(h->top==NULL)
        {
            cout<<"empty"<<endl;
            return;
        }
        Node *temp = h->top;
        while(temp!=NULL)
        {
            cout<<temp->data<<" ";
            temp = temp->next;
        }
    }
};
int main()
{
    Mystack s;
    s.createstack();

    int choice, x;

    do
    {
        cout << "\n\n--- STACK MENU ---";
        cout << "\n1. Push";
        cout << "\n2. Pop";
        cout << "\n3. Peek";
        cout << "\n4. Display";
        cout << "\n5. Exit";

        cout << "\nEnter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                cout << "Enter value: ";
                cin >> x;
                s.push(x);
                break;

            case 2:
                s.pop();
                break;

            case 3:
                s.peek();
                break;

            case 4:
                s.display();
                break;

            case 5:
                cout << "Exit";
                break;

            default:
                cout << "Invalid choice";
        }

    } while(choice != 5);

    return 0;
}
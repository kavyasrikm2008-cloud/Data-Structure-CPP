#include<iostream>
using namespace std;
struct Node
{
    int data;
    Node *left;
    Node *right;
};
class Bst
{
    public:
    Node *root;
    
    Bst()
    {
        root = NULL;
    }
    Node *createNode(int value)
    {
        Node *nn = new Node;
        nn->data = value;
        nn->left = NULL;
        nn->right = NULL;
        return nn;
    }
   Node *addBST(Node *root, int value)
   {
       if(root == NULL)
       {
          return createNode(value);
       }
       if(value<root->data)
       {
          root->left =  addBST(root->left,value);
       }
       else
       {
           root->right = addBST(root->right,value);
       }
       return root;
   }
  
   Node *findSmallest(Node *root)
   {
       if(root == NULL)
       {
           return NULL;
       }
       if(root->left == NULL)
       {
           return root;
       }
       return findSmallest(root->left);
   }
   Node *findLargest(Node *root)
   {
       if(root == NULL)
       {
           return NULL;
       }
       if(root->right == NULL)
       {
           return root;
       }
       return findLargest(root->right);
   }
    Node *deleteBST(Node *root, int dltkey)
    {
        if(root == NULL)
        {
            return NULL;
        }
        if(dltkey<root->data)
        {
            root->left = deleteBST(root->left, dltkey);
        }
        else if(dltkey>root->data)
        {
            root->right = deleteBST(root->right, dltkey);
        }
        else
        {
            if(root->left == NULL)
            {
                Node *temp = root->right;
                delete root;
                return temp;
            }
            else if(root->right == NULL)
            {
                Node *temp = root->left;
                delete root;
                return temp;
            }
            else
            {
                Node *largest = findLargest(root->left);
                root->data = largest->data;
                return deleteBST(root->left,largest->data);
            }
        }
        return root;
    }
    Node *searchBST(Node *root, int targetkey)
    {
        if(root == NULL)
        {
            return NULL;
        }
        if(targetkey<root->data)
        {
            return searchBST(root->left,targetkey);
        }
        else if(targetkey>root->data)
        {
            return searchBST(root->right, targetkey);
        }
        else
        {
            return root;
        }
    }
    void preOrder(Node *root)
    {
        if(root != NULL)
        {
            cout<<root->data<<" ";
            preOrder(root->left);
            preOrder(root->right);
        }
    }
    void inOrder(Node *root)
    {
        if(root != NULL)
        {
            inOrder(root->left);
            cout<<root->data<<" ";
            inOrder(root->right);
        }
    }
    void postOrder(Node *root)
    {
        if(root != NULL)
        {
            postOrder(root->left);
            postOrder(root->right);
            cout<<root->data<<" ";
        }
    }
   
};
int main()
{
    Bst b;
    Node *root = NULL;
    int ch,data;
    do{
        cout<<"\n---MENU DRIVEN---"<<endl;
        cout<<"1. INSERT NODE"<<endl;
        cout<<"2. DELETE NODE"<<endl;
        cout<<"3. SEARCH NODE"<<endl;
        cout<<"4. FINDLARGEST"<<endl;
        cout<<"5. FINDSMALLEST"<<endl;
        cout<<"6. PREORDER"<<endl;
        cout<<"7. INORDER"<<endl;
        cout<<"8. POSTORDER"<<endl;
        cout<<"9.EXIT"<<endl;
        
        cout<<"Enter your choice: ";
        cin>>ch;
        
        switch(ch)
        {
            case 1:
            cout<<"Enter data: ";
            cin>>data;
           root = b.addBST(root, data);
            break;
            
            case 2:
           cout << "Enter data: ";
           cin >> data;

           if(b.searchBST(root, data) != NULL)
            {
             root = b.deleteBST(root, data);
             cout << "Deleted";
            }
            else
           {
            cout << "Not Found";
           }

           break;
          
            
           case 3:
           cout << "Enter data: ";
           cin >> data;

           if(b.searchBST(root, data) != NULL)
            cout << "Found";
            else
            cout << "Not Found";

             break;

            case 4:
            cout << "Largest = " << b.findLargest(root)->data;
            break;

            case 5:
            cout << "Smallest = " << b.findSmallest(root)->data;
            break; 
            
            case 6:
            b.preOrder(root);
            break;
            
            case 7:
            b.inOrder(root);
            break;
            
            case 8:
            b.postOrder(root);
            break;
            
            case 9:
            cout<<"EXIT"<<endl;
            break;
            
            default:
            cout<<"Enter valid choice";
            
        }
        
    }while(ch != 9);
    return 0;
}
